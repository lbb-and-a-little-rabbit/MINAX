# 本文件是配置示例，不会自动加载。PowerShell 使用 $env:NAME="value"。
MINAX_HOST=127.0.0.1
MINAX_PORT=8787
# 默认根目录 bin/minax_calculator.exe，迁移后填写绝对路径
# MINAX_NATIVE_EXE=D:\workspace\software\commerce\minax\bin\minax_calculator.exe
# MINAX_WEB_DIR=D:\workspace\software\commerce\minax\frontend\dist
# MINAX_DB_PATH=D:\minax-data\minax.sqlite3
# HTTPS 服务器必须启用：
MINAX_SECURE_COOKIE=0
# 默认仅同源。跨源开发需要明确允许来源，不要用 *
# MINAX_ALLOWED_ORIGINS=http://localhost:5173

